# Dockerfile.agent_engine
# Google Cloud Run / Vertex AI Agent Engine Serverless Container
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080 \
    PYTHONPATH=/app/backend

WORKDIR /app

# Install system dependencies (build-essential, etc. if needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy backend codebase
COPY backend/ /app/backend/

# Expose standard Cloud Run port
EXPOSE 8080

# Health check probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Start the ADK Serverless Runtime
CMD ["uvicorn", "agent_engine.serverless_app:app", "--host", "0.0.0.0", "--port", "8080"]
